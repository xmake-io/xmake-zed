  {
    "label": "xmake: install workspace tasks",
    "command": "xmake",
    "args": [
      "lua",
      "-c",
      "local cwd = '$' .. 'ZED_WORKTREE_ROOT'\nlocal function fill(body)\n    local out = {}\n    local i = 1\n    while true do\n        local s, e = body:find('@CWD@', i, true)\n        if not s then\n            out[#out + 1] = body:sub(i)\n            break\n        end\n        out[#out + 1] = body:sub(i, s - 1)\n        out[#out + 1] = cwd\n        i = e + 1\n    end\n    return table.concat(out)\nend\nos.mkdir('.zed')\nio.writefile('.zed/tasks.json', fill([=[\n[\n  {\n    \"label\": \"xmake: build\",\n    \"command\": \"xmake\",\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  },\n  {\n    \"label\": \"xmake: clean\",\n    \"command\": \"xmake\",\n    \"args\": [\"clean\"],\n    \"cwd\": \"@CWD@\"\n  },\n  {\n    \"label\": \"xmake: run\",\n    \"command\": \"xmake\",\n    \"args\": [\"run\"],\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  },\n  {\n    \"label\": \"xmake: debug\",\n    \"command\": \"xmake\",\n    \"args\": [\n      \"lua\",\n      \"-c\",\n      \"os.execv('xmake', {'f', '-m', 'debug', '-y'}); os.execv('xmake', {})\"\n    ],\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  },\n  {\n    \"label\": \"xmake: debug in terminal\",\n    \"command\": \"xmake\",\n    \"args\": [\n      \"lua\",\n      \"-c\",\n      \"os.execv('xmake', {'f', '-m', 'debug', '-y'}); os.execv('xmake', {}); os.execv('xmake', {'run', '-d'})\"\n    ],\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  },\n  {\n    \"label\": \"xmake: generate compile_commands\",\n    \"command\": \"xmake\",\n    \"args\": [\n      \"lua\",\n      \"-c\",\n      \"os.mkdir('.zed'); os.execv('xmake', {'project', '-k', 'compile_commands', '--lsp=clangd', '.zed'}); if not os.isfile('.clangd') then io.writefile('.clangd', 'CompileFlags:\\\\n  CompilationDatabase: .zed\\\\n') end\"\n    ],\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  },\n  {\n    \"label\": \"xmake: show targets\",\n    \"command\": \"xmake\",\n    \"args\": [\"show\", \"-l\", \"targets\"],\n    \"cwd\": \"@CWD@\",\n    \"reveal\": \"always\"\n  }\n]\n]=]))\nlocal wrote_debug = not os.isfile('.zed/debug.json')\nif wrote_debug then\n    io.writefile('.zed/debug.json', fill([=[\n[\n  {\n    \"label\": \"xmake: debug current target\",\n    \"adapter\": \"CodeLLDB\",\n    \"build\": {\n      \"command\": \"xmake\",\n      \"args\": [\n        \"lua\",\n        \"-c\",\n        \"os.execv('xmake', {'f', '-m', 'debug', '-y'}); os.execv('xmake', {})\"\n      ],\n      \"cwd\": \"@CWD@\"\n    }\n  }\n]\n]=]))\nend\nif not os.isfile('.clangd') then\n    io.writefile('.clangd', 'CompileFlags:' .. string.char(10) .. '  CompilationDatabase: .zed' .. string.char(10))\nend\nif wrote_debug then\n    print('Wrote .zed/tasks.json and .zed/debug.json. Use task: spawn from any file. Debug with debugger: start, then xmake: debug.')\nelse\n    print('Wrote .zed/tasks.json. Use task: spawn from any file. Debug with debugger: start, then xmake: debug. An existing .zed/debug.json was left unchanged.')\nend\n"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always"
  },
